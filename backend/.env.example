# Copy to backend/.env and adjust. .env is git-ignored.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eticket
DB_USER=root
DB_PASS=
APP_TZ=Asia/Manila
APP_DEBUG=false

# Unpaid Pending reservations are cancelled (seats released) after this many hours. 0 = never.
RESERVATION_HOLD_HOURS=48

# Login / password-reset throttling: failures allowed per email+IP and per IP inside the window.
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_ACCOUNT=5
LOGIN_MAX_PER_IP=50

# How long an Administrator-issued password reset code stays valid.
PASSWORD_RESET_MINUTES=30

# Session cookie "Secure" flag: auto = on whenever the request is HTTPS; true = always (production).
SESSION_SECURE=auto
# Set to true ONLY behind a reverse proxy you control (trusts X-Forwarded-For / X-Forwarded-Proto).
TRUST_PROXY=false
