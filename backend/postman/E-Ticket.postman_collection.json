{
  "info": {
    "name": "E-Ticket API",
    "description": "Cookie sessions + CSRF. Run \"Login (admin)\" or \"Login (attendee)\" first: its test script stores the CSRF token in {{csrf}} and Postman keeps the session cookie. Fill ticketId / reservationId / eventId / attendeeId / ticketCode collection variables from earlier responses. Roles share one cookie jar, so log in as the role you want before each folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "ticketId",
      "value": "1"
    },
    {
      "key": "reservationId",
      "value": "1"
    },
    {
      "key": "attendeeId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "ticketCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (attendee only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) pm.collectionVariables.set(\"csrf\", j.csrf);",
                  "pm.test(\"status is 200/201\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.test(\"role is forced to attendee\", () => pm.expect(pm.response.json().user.role).to.eql(\"attendee\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_Name\": \"New Attendee\",\n  \"email\": \"new@eticket.test\",\n  \"password\": \"secret123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
